# Copy to server/.env, fill in real values, then just run a bridge — both
# calendar_bridge.py and presence_bridge.py load server/.env themselves
# (via env_file.py), no `source`/pip install needed:
#   cp server/.env.example server/.env && python3 server/calendar_bridge.py
# A real environment variable of the same name always wins over the file.
# Never commit server/.env — it's gitignored, this .example file is not.

# --- server/calendar_bridge.py: /calendar/today (calendar webhook) ---
CALENDAR_SOURCE_URL=https://example.invalid/webhook/calendar
CALENDAR_SOURCE_SECRET=

# --- server/calendar_bridge.py: /live (Home Assistant) ---
HA_URL=https://ha.example.invalid
HA_TOKEN=
HA_CALL_SENSOR=binary_sensor.teams_in_call
HA_WEBCAM_SENSOR=binary_sensor.pw0q6czd_webcamactive
HA_TEAMS_STATUS_SENSOR=sensor.teams_status
HA_PRESENTING_STATES=Presenting

# --- server/presence_bridge.py: all-HA alternative (calendar + live both
#     from HA) — only needed if you're using this bridge instead of
#     calendar_bridge.py. Shares HA_CALL_SENSOR/HA_WEBCAM_SENSOR above,
#     but has no HA_TEAMS_STATUS_SENSOR support — it wants its own
#     dedicated "presenting" binary sensor instead. ---
# HA_PRESENTING_SENSOR=
# HA_CALENDAR_ENTITY=calendar.your_calendar
# HA_TIME_ZONE=W. Europe Standard Time
# HA_CUSTOMER_KEYWORDS=customer,client
# HA_LEADERSHIP_KEYWORDS=ceo,cfo,coo,leadership,board
# HA_SOLO_KEYWORDS=lunch,focus,personal,doctor,dentist
