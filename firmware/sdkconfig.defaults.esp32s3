
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Dynamic frequency scaling: CPU idles down from 240MHz to 80MHz between
# bursts of work (WiFi/HTTP polls, SPI/e-ink refreshes, audio) instead of
# staying pinned at 240MHz. min_freq_mhz is kept at 80 (== APB clock) so the
# APB/PLL clock itself is never dropped or switched to XTAL — SPI (e-ink) and
# WiFi timing are unaffected; ESP-IDF's spi_master/WiFi drivers already
# acquire the necessary esp_pm locks during transfers. Light sleep itself
# (light_sleep_enable) is intentionally left off for now — see
# tmp/optimizations-todo.md for the reasoning and the required hardware
# soak-test before enabling it.
CONFIG_PM_ENABLE=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536

CONFIG_ZECTRIX_EPD_PANEL_4COLOR_SSD2683=y
# CONFIG_ZECTRIX_EPD_4COLOR_BOOT_TEST_PATTERN is not set

# LVGL Graphics
CONFIG_LV_USE_SNAPSHOT=y

# Bluetooth BLE
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
